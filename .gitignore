# Local Claude Code settings — machine-specific.
.claude/

# Temporary. GitHub refuses pushes that touch workflows unless the token has
# the `workflow` scope. Grant it with `gh auth refresh -s workflow`, then delete
# these two lines to switch from `npm run deploy` to automated deploys.
.github/workflows/

# Avatar models. The presets are fetched with `npm run fetch-avatar` and are
# trivially re-downloadable; hand-supplied models are several MB of binary that
# would bloat history. Both are copied into the deployed build regardless.
public/avatars/*.glb
public/avatars/*.fbx
avatar.zip

.env
.env.local
.DS_Store
Thumbs.db
